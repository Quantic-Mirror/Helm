# Sunday 21:00 Eastern -- an hour after helm-code-audit.timer (20:00) so the
# two weekly reports don't land together, and safely before hyperion's
# typical ~22:00 shutdown (it's on all day, off overnight). The original
# 23:00 would have reliably missed hyperion entirely.
[Unit]
Description=Weekly host maintenance at Sunday 21:00 Eastern

[Timer]
OnCalendar=Sun *-*-* 21:00:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
