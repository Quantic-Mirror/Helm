# VPS user unit. Install: copy to ~/.config/systemd/user/ on the VPS, then
#   systemctl --user daemon-reload && systemctl --user enable --now helm-morning-digest.timer
[Unit]
Description=Mail the morning Helm activity digest

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/helm/scripts/morning_digest.py
Environment=HELM_STATE_DIR=%h/helm/data
StandardOutput=journal
StandardError=journal
