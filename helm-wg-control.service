[Unit]
Description=Helm WireGuard VPN control backend (wg_control_server.py, proxied from helm_server.py's container)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
# Runs as ROOT (system-scope, not --user), deliberately not via
# AmbientCapabilities=CAP_NET_ADMIN on a dedicated user — wg-quick shells out
# to ip/iptables/(iptables-nft or -legacy depending on the host), and
# capability-vs-root behavior across those tools is inconsistent enough
# across distros that a kill switch silently degrading (fail-open) is a
# worse outcome than the marginal blast-radius reduction capabilities would
# buy here, on a single-user VPS where this process's entire job is host
# network control anyway. Systemd sandboxing below gets most of the
# practical containment without that reliability risk.
Type=simple
WorkingDirectory=/home/isaboo/repos/Helm
Environment=WG0_SUBNET=10.66.0.0/24
# Environment=WG_EGRESS_IFACE=eth0
ExecStart=/usr/bin/python3 /home/isaboo/repos/Helm/wg_control_server.py /run/helm-wg-control.sock
Restart=on-failure
RestartSec=5

ProtectSystem=strict
ReadWritePaths=/etc/wireguard /run /etc/helm-wg
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
