[Unit]
Description=Helm backup-pipeline event worker (drains RabbitMQ backup.events into backup_events.json)
After=network-online.target rabbitmq-server.service
Wants=network-online.target

[Service]
Type=simple
User=carl
WorkingDirectory=/home/carl/repos/Helm
ExecStart=/usr/bin/python3 /home/carl/repos/Helm/backup_event_worker.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
