# ── Host configuration (no hardcoded hostnames) ────────────────────────────────

# Which host interface Docker publishes the container ports on:
#   127.0.0.1           loopback only — reachable just from this machine (default)
#   <your Tailscale IP> tailnet-only access. Recommended for a single user; pair
#                       with a self-signed cert whose CN is this same IP. Find it
#                       with `tailscale ip -4`.
#   0.0.0.0             every interface — ONLY behind a reverse proxy + auth
#                       (Helm has no built-in auth) with Let's Encrypt certs.
HELM_BIND=127.0.0.1

# The address browsers use to reach Helm — feeds /api/config so the frontend
# builds correct URLs. In Tailscale mode set this to the SAME value as HELM_BIND;
# for public/LAN use your domain or LAN IP.
SERVER_HOST=100.111.222.33

# Optional: fully override a port mapping ("bind_ip:host_port:container_port"),
# e.g. to serve the dashboard on 443. Takes precedence over HELM_BIND.
# helm_server.py serves HTTPS on 8443 inside the container (plain HTTP there
# only if data/cert.pem is absent).
# HELM_PORT=0.0.0.0:443:8443
# SEARXNG_PORT=127.0.0.1:8081:8080

# ── Backend service hosts ──────────────────────────────────────────────────────

# The host running vault_server.py (pass + gpg) — your dual-boot machine.
# For Tailscale: this is that machine's Tailscale IP (reachable from the VPS
# over the tailnet). Set to the machine's Tailscale IP.
VAULT_HOST=100.99.88.77

# The host running audio_grabber_server.py (yt-dlp).
# Same as VAULT_HOST if both services run on the same machine.
AUDIO_HOST=100.99.88.77

# SearXNG runs as a container on this VPS, so always localhost.
SEARXNG_HOST=localhost

# ─── Container user (find yours: id -u && id -g) ────────────────────────────────
HELM_UID=1000
HELM_GID=1000

# Docker group GID (so the container can control Docker containers).
# Find yours: getent group docker | cut -d: -f3
DOCKER_GID=999

# ── Secrets (DO NOT commit real values) ────────────────────────────────────────
# Copy these from your existing setup:

# vault_token.txt: run `openssl rand -hex 32 > data/vault_token.txt` and copy
# the same file to the host running vault_server.py.
# audio_token.txt: same process, for audio_grabber_server.py.
# backup_token.txt: shared secret for POST /api/backup-events. Generate with
#   openssl rand -hex 32 > data/backup_token.txt
# and copy the SAME file to every host that runs emit_event.py (the backup
# scripts on hyperion / popcorn). Point those at it with HELM_BACKUP_TOKEN_FILE
# and set HELM_URL to this host's Tailscale URL (https://<ts-ip>:8443).

# SearXNG secret key (random string)
SEARXNG_SECRET_KEY=changeme-generate-a-real-one

# ─── TLS setup ──────────────────────────────────────────────────────────────────
# For Tailscale-only: generate a self-signed cert with CN set to your Tailscale IP:
#   openssl req -x509 -newkey rsa:2048 -nodes \
#     -keyout data/key.pem -out data/cert.pem -days 3650 \
#     -subj "/CN=${SERVER_HOST}"
# Import the cert into your browser once to avoid warnings.

# For public/LAN access: use Let's Encrypt (via nginx/caddy reverse proxy).
