[Unit]
Description=Keep Tailscale working alongside Windscribe (ip rule + nft accept)
After=tailscaled.service network-online.target
Wants=tailscaled.service

[Service]
Type=simple
# Windscribe rewrites its rules on reconnect with no hook to trigger on, so
# poll; the script is a no-op unless something is missing.
ExecStart=/bin/sh -c 'while :; do /usr/local/bin/tailscale-windscribe-fix.sh; sleep 5; done'
Restart=always

[Install]
WantedBy=multi-user.target
